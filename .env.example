# ═══════════════════════════════════════════════════════
#  MX-UI — Environment Variables
#  روی Railway: Settings → Variables
# ═══════════════════════════════════════════════════════

# ── پورت (Railway خودش set می‌کنه) ────────────────────
PORT=8080
INTERNAL_PORT=8001

# ── اختیاری ───────────────────────────────────────────
TZ=Asia/Tehran

# نکته:
# - ADMIN_PASSWORD نیازی نیست — از /setup تنظیم می‌شه
# - SECRET_KEY نیازی نیست — خودکار ساخته و در /data ذخیره می‌شه
